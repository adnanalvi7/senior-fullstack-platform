# Environment configuration for CapEx Platform

DJANGO_SECRET_KEY=production-grade-capex-platform-secure-key-2026
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL)
DB_ENGINE=postgres
POSTGRES_DB=capex_db
POSTGRES_USER=capex_user
POSTGRES_PASSWORD=capex_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis: one URL; logical DBs are derived (/0 Celery broker, /1 cache, /2 Channels).
# Override individually with CELERY_BROKER_URL / REDIS_CACHE_URL / CHANNELS_REDIS_URL.
REDIS_URL=redis://redis:6379/0
# Set USE_REDIS=false only for Redis-less local dev (in-memory cache/channels, eager Celery).
USE_REDIS=true

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
